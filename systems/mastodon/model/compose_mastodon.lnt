-- compose_mastodon.lnt -- COMPOSED = SPEC || SI, synchronised on the whole
-- abstract alphabet (journeys, observables and faults); the five concrete
-- primitives stay visible for the generated test case.
--
--   lnt.open -main COMPOSED compose_mastodon.lnt generator compose_mastodon.bcg

module compose_mastodon (mastodon_types, specification_mastodon, system_interface_mastodon)
is

process COMPOSED [
    navigate  : Ch_Route,
    click     : Ch_Selector,
    type_into : Ch_TypeIn,
    wait_for  : Ch_Element,
    observe   : Ch_Element,
    ADD     : AddChannel,
    CONFIRM : ConfirmChannel,
    EDIT    : RecordChannel,
    REMOVE  : RecordChannel,
    CHECK   : RecordChannel,
    PEEK    : RecordChannel,
    SHOW    : ShowChannel,
    WRITE_ERROR_SHOWN   : none,
    REJECT_SHOWN        : none,
    DB_CORRUPT_DETECTED : none,
    UE_KILL             : none,
    UE_SESSION_EXPIRED  : none,
    APP_WRITE_FAIL      : none,
    APP_UNAVAILABLE     : none,
    APP_EXTAPI_FAIL     : none,
    APP_CACHE_STALE     : none,
    APP_LAZY_PROCESSING : none,
    DB_ABORT            : none,
    DB_CORRUPT          : none,
    DB_EVENT_LOSS       : none,
    INFRA_DB_DOWN       : none,
    INFRA_SIDEKIQ_DEAD  : none,
    INFRA_STORAGE_FULL  : none
] is
    par ADD, CONFIRM, EDIT, REMOVE, CHECK, PEEK, SHOW,
        WRITE_ERROR_SHOWN, REJECT_SHOWN, DB_CORRUPT_DETECTED,
        UE_KILL, UE_SESSION_EXPIRED, APP_WRITE_FAIL, APP_UNAVAILABLE,
        APP_EXTAPI_FAIL, APP_CACHE_STALE, APP_LAZY_PROCESSING,
        DB_ABORT, DB_CORRUPT, DB_EVENT_LOSS,
        INFRA_DB_DOWN, INFRA_SIDEKIQ_DEAD, INFRA_STORAGE_FULL in
        SPEC [ADD, CONFIRM, EDIT, REMOVE, CHECK, PEEK, SHOW,
              WRITE_ERROR_SHOWN, REJECT_SHOWN, DB_CORRUPT_DETECTED,
              UE_KILL, UE_SESSION_EXPIRED, APP_WRITE_FAIL, APP_UNAVAILABLE,
              APP_EXTAPI_FAIL, APP_CACHE_STALE, APP_LAZY_PROCESSING,
              DB_ABORT, DB_CORRUPT, DB_EVENT_LOSS,
              INFRA_DB_DOWN, INFRA_SIDEKIQ_DEAD, INFRA_STORAGE_FULL]
    ||
        SI [navigate, click, type_into, wait_for, observe,
            ADD, CONFIRM, EDIT, REMOVE, CHECK, PEEK, SHOW,
            WRITE_ERROR_SHOWN, REJECT_SHOWN, DB_CORRUPT_DETECTED,
            UE_KILL, UE_SESSION_EXPIRED, APP_WRITE_FAIL, APP_UNAVAILABLE,
            APP_EXTAPI_FAIL, APP_CACHE_STALE, APP_LAZY_PROCESSING,
            DB_ABORT, DB_CORRUPT, DB_EVENT_LOSS,
            INFRA_DB_DOWN, INFRA_SIDEKIQ_DEAD, INFRA_STORAGE_FULL]
    end par
end process

end module
