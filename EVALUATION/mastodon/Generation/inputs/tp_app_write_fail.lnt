module tp_app_write_fail (mastodon_types, mastodon_fixture) is

(* SHAPE    H, antispam drops the post at S1, S2 or S3.
   H        S1 post A, S2 post B, S3 post C, S4 read without refresh, S5 fresh check, S6 delete C.
   STRIKES  S1 post A: after_add APP_WRITE_FAIL; S2 post B: after_add APP_WRITE_FAIL; S3 post C: after_add APP_WRITE_FAIL (any of these; extract_all resolves which).
   ACCEPT   the disruption strikes and the owed outputs follow.
   REFUSE   H completes without the disruption; any input not expected at
            its point; any fault or input this purpose never uses.
   Owed     WRITE_ERROR_SHOWN then CONFIRM (ROLLED_BACK) (O2).
   Expected FAIL on O2: "Post published." for a dropped post (live) (observed_behaviour.md §12-13).
   Generated by make_purposes.py: edit the table there, not this file. *)

process MAIN [
    ADD     : AddChannel,
    CONFIRM : ConfirmChannel,
    EDIT    : RecordChannel,
    REMOVE  : RecordChannel,
    CHECK   : RecordChannel,
    PEEK    : RecordChannel,
    SHOW    : ShowChannel,
    WRITE_ERROR_SHOWN   : none,
    REJECT_SHOWN        : none,
    DB_CORRUPT_DETECTED : none,
    UE_KILL             : none,
    UE_SESSION_EXPIRED  : none,
    APP_WRITE_FAIL      : none,
    APP_UNAVAILABLE     : none,
    APP_EXTAPI_FAIL     : none,
    APP_CACHE_STALE     : none,
    APP_LAZY_PROCESSING : none,
    DB_ABORT            : none,
    DB_CORRUPT          : none,
    DB_EVENT_LOSS       : none,
    INFRA_DB_DOWN       : none,
    INFRA_SIDEKIQ_DEAD  : none,
    INFRA_STORAGE_FULL  : none,
    TP_ACCEPT           : none,
    TP_REFUSE           : none
] is
    var RID : RecordId in
        RID := defaultRecord;
        disrupt
            alt
                ADD (post_a, PUBLIC, VALID);
                alt
                    APP_WRITE_FAIL;
                    WRITE_ERROR_SHOWN;
                    CONFIRM (ROLLED_BACK, ?any CountBand, ?any HomeState, ?any ProfileState, post_a);
                    loop TP_ACCEPT end loop
                []
                    CONFIRM (COMMITTED, ?any CountBand, ?any HomeState, ?any ProfileState, post_a);
                    alt
                        ADD (post_b, PUBLIC, VALID);
                        alt
                            APP_WRITE_FAIL;
                            WRITE_ERROR_SHOWN;
                            CONFIRM (ROLLED_BACK, ?any CountBand, ?any HomeState, ?any ProfileState, post_b);
                            loop TP_ACCEPT end loop
                        []
                            CONFIRM (COMMITTED, ?any CountBand, ?any HomeState, ?any ProfileState, post_b);
                            alt
                                ADD (post_c, PUBLIC, VALID);
                                alt
                                    APP_WRITE_FAIL;
                                    WRITE_ERROR_SHOWN;
                                    CONFIRM (ROLLED_BACK, ?any CountBand, ?any HomeState, ?any ProfileState, post_c);
                                    loop TP_ACCEPT end loop
                                []
                                    CONFIRM (COMMITTED, ?any CountBand, ?any HomeState, ?any ProfileState, post_c);
                                    alt
                                        PEEK (RID);
                                        SHOW (RID, ?any Value);
                                        alt
                                            CHECK (RID);
                                            CONFIRM (?any WriteStatus, ?any CountBand, ?any HomeState, ?any ProfileState, post_c);
                                            alt
                                                REMOVE (RID);
                                                CONFIRM (COMMITTED, ?any CountBand, ?any HomeState, ?any ProfileState, post_c);
                                                loop TP_REFUSE end loop
                                            []
                                                alt
                                                    ADD (post_a, PUBLIC, VALID)
                                                []
                                                    ADD (post_b, PUBLIC, VALID)
                                                []
                                                    ADD (post_c, PUBLIC, VALID)
                                                []
                                                    APP_WRITE_FAIL
                                                []
                                                    CHECK (RID)
                                                []
                                                    PEEK (RID)
                                                end alt;
                                                loop TP_REFUSE end loop
                                            end alt
                                        []
                                            alt
                                                ADD (post_a, PUBLIC, VALID)
                                            []
                                                ADD (post_b, PUBLIC, VALID)
                                            []
                                                ADD (post_c, PUBLIC, VALID)
                                            []
                                                APP_WRITE_FAIL
                                            []
                                                PEEK (RID)
                                            []
                                                REMOVE (RID)
                                            end alt;
                                            loop TP_REFUSE end loop
                                        end alt
                                    []
                                        CHECK (RID);
                                        CONFIRM (?any WriteStatus, ?any CountBand, ?any HomeState, ?any ProfileState, post_c);
                                        alt
                                            PEEK (RID);
                                            SHOW (RID, ?any Value);
                                            alt
                                                REMOVE (RID);
                                                CONFIRM (COMMITTED, ?any CountBand, ?any HomeState, ?any ProfileState, post_c);
                                                loop TP_REFUSE end loop
                                            []
                                                alt
                                                    ADD (post_a, PUBLIC, VALID)
                                                []
                                                    ADD (post_b, PUBLIC, VALID)
                                                []
                                                    ADD (post_c, PUBLIC, VALID)
                                                []
                                                    APP_WRITE_FAIL
                                                []
                                                    CHECK (RID)
                                                []
                                                    PEEK (RID)
                                                end alt;
                                                loop TP_REFUSE end loop
                                            end alt
                                        []
                                            alt
                                                ADD (post_a, PUBLIC, VALID)
                                            []
                                                ADD (post_b, PUBLIC, VALID)
                                            []
                                                ADD (post_c, PUBLIC, VALID)
                                            []
                                                APP_WRITE_FAIL
                                            []
                                                CHECK (RID)
                                            []
                                                REMOVE (RID)
                                            end alt;
                                            loop TP_REFUSE end loop
                                        end alt
                                    []
                                        alt
                                            ADD (post_a, PUBLIC, VALID)
                                        []
                                            ADD (post_b, PUBLIC, VALID)
                                        []
                                            ADD (post_c, PUBLIC, VALID)
                                        []
                                            APP_WRITE_FAIL
                                        []
                                            REMOVE (RID)
                                        end alt;
                                        loop TP_REFUSE end loop
                                    end alt
                                end alt
                            []
                                alt
                                    ADD (post_a, PUBLIC, VALID)
                                []
                                    ADD (post_b, PUBLIC, VALID)
                                []
                                    APP_WRITE_FAIL
                                []
                                    CHECK (RID)
                                []
                                    PEEK (RID)
                                []
                                    REMOVE (RID)
                                end alt;
                                loop TP_REFUSE end loop
                            end alt
                        end alt
                    []
                        alt
                            ADD (post_a, PUBLIC, VALID)
                        []
                            ADD (post_c, PUBLIC, VALID)
                        []
                            APP_WRITE_FAIL
                        []
                            CHECK (RID)
                        []
                            PEEK (RID)
                        []
                            REMOVE (RID)
                        end alt;
                        loop TP_REFUSE end loop
                    end alt
                end alt
            []
                alt
                    ADD (post_b, PUBLIC, VALID)
                []
                    ADD (post_c, PUBLIC, VALID)
                []
                    APP_WRITE_FAIL
                []
                    CHECK (RID)
                []
                    PEEK (RID)
                []
                    REMOVE (RID)
                end alt;
                loop TP_REFUSE end loop
            end alt
        by
            -- every fault and input this purpose never uses
            alt
                UE_KILL
            []
                UE_SESSION_EXPIRED
            []
                APP_UNAVAILABLE
            []
                APP_EXTAPI_FAIL
            []
                APP_CACHE_STALE
            []
                APP_LAZY_PROCESSING
            []
                DB_ABORT
            []
                DB_CORRUPT
            []
                DB_EVENT_LOSS
            []
                INFRA_DB_DOWN
            []
                INFRA_SIDEKIQ_DEAD
            []
                INFRA_STORAGE_FULL
            []
                ADD (?any ItemId, FOLLOWERS, ?any Validity)
            []
                EDIT (?any RecordId)
            []
                ADD (?any ItemId, PUBLIC, INVALID)
            []
                ADD (?any ItemId, PUBLIC, OVERLIMIT)
            []
                PEEK (rec_a)
            []
                CHECK (rec_a)
            []
                REMOVE (rec_a)
            []
                PEEK (rec_b)
            []
                CHECK (rec_b)
            []
                REMOVE (rec_b)
            end alt;
            loop TP_REFUSE end loop
        end disrupt
    end var
end process

end module
