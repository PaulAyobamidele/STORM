module tp_delete_skipped (medtimer_types, medtimer_fixture) is

(* SHAPE    parameter-borne, two-step (a skip, then its deletion).
   TARGET   a skipped dose is deleted.
   ACCEPT   the record is gone and the stock is unchanged: a dose never taken
            has nothing to give back (O5).
   REFUSE   any fault; a take; any other input.
   Owed     CONFIRM (COMMITTED, ?band, ABSENT, IDF) with the band unmoved.
   Expected FAIL: the deletion refunds a unit (§4.4, confirmed live §15:
            three to four pills). *)

process MAIN [
    ADD_MEDICINE : AddMedChannel,
    MEDICINE_SHOWN      : none,
    REJECT_SHOWN        : none,
    NO_SKIP : MedChannel,
    ACT     : ActChannel,
    DELETE  : MedChannel,
    EDIT    : ActChannel,
    VIEW    : MedChannel,
    CONFIRM : ConfirmChannel,
    WRITE_ERROR_SHOWN   : none,
    DB_CORRUPT_DETECTED : none,
    INFRA_STORAGE_ERROR : none,
    UE_KILL             : none,
    APP_WRITE_FAIL      : none,
    APP_CACHE_STALE     : none,
    DB_ABORT            : none,
    DB_CORRUPT          : none,
    DB_EVENT_LOSS       : none,
    INFRA_STORAGE_FULL  : none,
    INFRA_STORAGE_MEDIA : none,
    TP_ACCEPT           : none,
    TP_REFUSE           : none
] is
    var IDF : MedicineId in
        IDF := defaultMedicine;
        disrupt
            ACT     (IDF, SKIP);
            CONFIRM (COMMITTED, ?any StockBand, SKIPPED, IDF);
            DELETE  (IDF);
            CONFIRM (COMMITTED, ?any StockBand, ABSENT, IDF);
            loop TP_ACCEPT end loop
        by
            alt
                UE_KILL
            []  APP_WRITE_FAIL
            []  APP_CACHE_STALE
            []  DB_ABORT
            []  DB_CORRUPT
            []  DB_EVENT_LOSS
            []  INFRA_STORAGE_FULL
            []  INFRA_STORAGE_MEDIA
            []  ADD_MEDICINE (?any Validity)
            []  NO_SKIP (?any MedicineId)
            []  ACT (?any MedicineId, TAKE)
            []  EDIT (?any MedicineId, ?any DoseAction)
            []  VIEW (?any MedicineId)
            end alt;
            loop TP_REFUSE end loop
        end disrupt
    end var
end process

end module
