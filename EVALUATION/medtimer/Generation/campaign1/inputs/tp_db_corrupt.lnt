module tp_db_corrupt (medtimer_types, medtimer_fixture) is

(* SHAPE    two-phase, then interrupt.
   TARGET   DB_CORRUPT: the day's record is made unreadable underneath the app.
   PHASE 1  mark the day's dose Taken, so there is a record to read.
   PHASE 2  re-read the day: ACCEPT when the fault interrupts the read and
            the app says so; REFUSE if the read completes.
   REFUSE   any other fault, any other input, in either phase; the target
            firing in phase 1 (too early: not this trace).
   Owed     DB_CORRUPT_DETECTED.
   Expected FAIL: the reader crashes on the bad value, nothing is flagged (O6). *)

process MAIN [
    ADD_MEDICINE : AddMedChannel,
    MEDICINE_SHOWN      : none,
    REJECT_SHOWN        : none,
    NO_SKIP : MedChannel,
    ACT     : ActChannel,
    DELETE  : MedChannel,
    EDIT    : ActChannel,
    VIEW    : MedChannel,
    CONFIRM : ConfirmChannel,
    WRITE_ERROR_SHOWN   : none,
    DB_CORRUPT_DETECTED : none,
    INFRA_STORAGE_ERROR : none,
    UE_KILL             : none,
    APP_WRITE_FAIL      : none,
    APP_CACHE_STALE     : none,
    DB_ABORT            : none,
    DB_CORRUPT          : none,
    DB_EVENT_LOSS       : none,
    INFRA_STORAGE_FULL  : none,
    INFRA_STORAGE_MEDIA : none,
    TP_ACCEPT           : none,
    TP_REFUSE           : none
] is
    var IDF : MedicineId in
        IDF := defaultMedicine;
        disrupt
            disrupt
                ACT     (IDF, TAKE);
                CONFIRM (COMMITTED, ?any StockBand, TAKEN, IDF)
            by
                DB_CORRUPT;
                loop TP_REFUSE end loop
            end disrupt;
            disrupt
                VIEW    (IDF);
                CONFIRM (COMMITTED, ?any StockBand, ?any DoseState, IDF);
                loop TP_REFUSE end loop
            by
                DB_CORRUPT;
                DB_CORRUPT_DETECTED;
                loop TP_ACCEPT end loop
            end disrupt
        by
            alt
                UE_KILL
            []  APP_WRITE_FAIL
            []  APP_CACHE_STALE
            []  DB_ABORT
            []  DB_EVENT_LOSS
            []  INFRA_STORAGE_FULL
            []  INFRA_STORAGE_MEDIA
            []  ADD_MEDICINE (?any Validity)
            []  NO_SKIP (?any MedicineId)
            []  ACT (?any MedicineId, SKIP)
            []  DELETE (?any MedicineId)
            []  EDIT (?any MedicineId, ?any DoseAction)
            end alt;
            loop TP_REFUSE end loop
        end disrupt
    end var
end process

end module
