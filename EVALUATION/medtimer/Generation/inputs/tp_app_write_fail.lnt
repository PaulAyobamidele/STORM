                                                    []  VIEW (d_a3)
                                                    end alt;
                                                    loop TP_REFUSE end loop
                                                end alt;
                                                alt
                                                    CONFIRM (COMMITTED, ?any StockBand, TAKEN, d_b)
                                                []
                                                    alt
                                                        APP_WRITE_FAIL
                                                    []  INFRA_STORAGE_FULL
                                                    []  UE_KILL
                                                    []  DB_ABORT
                                                    []  APP_CACHE_STALE
                                                    []  DB_CORRUPT
                                                    []  DB_CORRUPT_STOCK
                                                    []  INFRA_STORAGE_MEDIA
