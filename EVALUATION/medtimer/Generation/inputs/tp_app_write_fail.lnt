                                                    []  ADD_MEDICINE (VALID)
                                                    []  ADD_MEDICINE (INVALID)
                                                    []  NO_SKIP (med_a)
                                                    []  NO_SKIP (med_b)
                                                    []  ACT (d_a1, TAKE)
                                                    []  ACT (d_a1, SKIP)
                                                    []  ACT (d_a2, TAKE)
                                                    []  ACT (d_a2, SKIP)
                                                    []  ACT (d_a3, TAKE)
                                                    []  ACT (d_a3, SKIP)
                                                    []  ACT (d_b, TAKE)
                                                    []  ACT (d_b, SKIP)
                                                    []  DELETE (d_a1)
                                                    []  DELETE (d_a2)
                                                    []  DELETE (d_a3)
                                                    []  DELETE (d_b)
                                                    []  EDIT (d_a1, TAKE)
                                                    []  EDIT (d_a1, SKIP)
                                                    []  EDIT (d_a2, TAKE)
                                                    []  EDIT (d_a2, SKIP)
