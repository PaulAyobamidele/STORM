                                                    []  VIEW (d_a2)
                                                    []  VIEW (d_a3)
                                                    []  VIEW (d_b)
                                                    end alt;
                                                    loop TP_REFUSE end loop
                                                end alt;
                                                alt
                                                    EDIT (d_a3, SKIP);
                                                    alt
                                                        CONFIRM (COMMITTED, ?any StockBand, SKIPPED, d_a3);
                                                        loop TP_REFUSE end loop
                                                    []
                                                        APP_WRITE_FAIL;
                                                        alt
                                                            WRITE_ERROR_SHOWN
                                                        []
                                                            alt
                                                                APP_WRITE_FAIL
                                                            []  INFRA_STORAGE_FULL
                                                            []  UE_KILL
                                                            []  DB_ABORT
                                                            []  APP_CACHE_STALE
                                                            []  DB_CORRUPT
                                                            []  DB_CORRUPT_STOCK
                                                            []  INFRA_STORAGE_MEDIA
                                                            []  DB_EVENT_LOSS
                                                            []  ADD_MEDICINE (VALID)
