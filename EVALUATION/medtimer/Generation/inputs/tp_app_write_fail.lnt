                                        alt
                                            ACT (d_b, TAKE);
                                            alt
                                                CONFIRM (COMMITTED, ?any StockBand, TAKEN, d_b);
                                                alt
                                                    VIEW (d_b)
                                                []
                                                    alt
                                                        APP_WRITE_FAIL
                                                    []  INFRA_STORAGE_FULL
                                                    []  UE_KILL
                                                    []  DB_ABORT
                                                    []  APP_CACHE_STALE
                                                    []  DB_CORRUPT
                                                    []  DB_CORRUPT_STOCK
                                                    []  INFRA_STORAGE_MEDIA
                                                    []  DB_EVENT_LOSS
                                                    []  ADD_MEDICINE (VALID)
                                                    []  ADD_MEDICINE (INVALID)
                                                    []  NO_SKIP (med_a)
                                                    []  NO_SKIP (med_b)
                                                    []  ACT (d_a1, TAKE)
                                                    []  ACT (d_a1, SKIP)
                                                    []  ACT (d_a2, TAKE)
                                                    []  ACT (d_a2, SKIP)
                                                    []  ACT (d_a3, TAKE)
                                                    []  ACT (d_a3, SKIP)
                                                    []  ACT (d_b, TAKE)
                                                    []  ACT (d_b, SKIP)
                                                    []  DELETE (d_a1)
                                                    []  DELETE (d_a2)
                                                    []  DELETE (d_a3)
                                                    []  DELETE (d_b)
