            loop TP_REFUSE end loop
        end alt;
        alt
            ACT (d_a3, SKIP)
        []
            alt
                APP_WRITE_FAIL
            []  INFRA_STORAGE_FULL
            []  UE_KILL
            []  DB_ABORT
            []  APP_CACHE_STALE
