            []  EDIT (d_b, SKIP)
            []  VIEW (d_a1)
            []  VIEW (d_a2)
            []  VIEW (d_a3)
            []  VIEW (d_b)
            end alt;
            loop TP_REFUSE end loop
        end alt;
        loop TP_ACCEPT end loop
end process

