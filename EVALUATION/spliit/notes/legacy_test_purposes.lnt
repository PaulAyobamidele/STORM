module Test_Purposes (spliit_types) is

-- TP_U1: User goes offline after CREATE_EXPENSE
-- System path: 0 --(CREATE_EXPENSE)--> 1 --(UE1_OFFLINE)--> 6
-- ACCEPT triggers after UE1_OFFLINE fires post-expense.
process TP_U1 [
    CREATE_EXPENSE : ExpenseChannel,
    WRITE_DB       : ExpenseChannel,
    DATA_PERSISTED : ExpenseStatusChannel,
    BALANCE_SAVED  : ExpenseStatusChannel,
    UE1_OFFLINE    : none,
    APP_TIMEOUT    : TimeoutChannel,
    ACCEPT         : none,
    REFUSE         : none
] is
    CREATE_EXPENSE (?any GroupId, ?any ExpenseId, ?any Amount);
    UE1_OFFLINE;
    loop ACCEPT end loop
end process


-- TP_A1: APP_TIMEOUT fires before WRITE_DB
-- System path: 0 --(CREATE_EXPENSE)--> 1 --(APP_TIMEOUT)--> 5
-- ACCEPT triggers after APP_TIMEOUT fires before any DB write.
process TP_A1 [
    CREATE_EXPENSE : ExpenseChannel,
    WRITE_DB       : ExpenseChannel,
    DATA_PERSISTED : ExpenseStatusChannel,
    BALANCE_SAVED  : ExpenseStatusChannel,
    UE1_OFFLINE    : none,
    APP_TIMEOUT    : TimeoutChannel,
    ACCEPT         : none,
    REFUSE         : none
] is
    CREATE_EXPENSE (?any GroupId, ?any ExpenseId, ?any Amount);
    APP_TIMEOUT (?any GroupId);
    loop ACCEPT end loop
end process


-- TP_A2: APP_TIMEOUT fires after WRITE_DB, before DATA_PERSISTED
-- System path: 0 --(CREATE_EXPENSE)--> 1 --(WRITE_DB)--> 4 --(APP_TIMEOUT)--> 9
-- ACCEPT triggers after APP_TIMEOUT fires mid-write.
process TP_A2 [
    CREATE_EXPENSE : ExpenseChannel,
    WRITE_DB       : ExpenseChannel,
    DATA_PERSISTED : ExpenseStatusChannel,
    BALANCE_SAVED  : ExpenseStatusChannel,
    UE1_OFFLINE    : none,
    APP_TIMEOUT    : TimeoutChannel,
    ACCEPT         : none,
    REFUSE         : none
] is
    CREATE_EXPENSE (?any GroupId, ?any ExpenseId, ?any Amount);
    WRITE_DB (?any GroupId, ?any ExpenseId, ?any Amount);
    APP_TIMEOUT (?any GroupId);
    loop ACCEPT end loop
end process


-- TP_A3: APP_TIMEOUT fires after DATA_PERSISTED, before BALANCE_SAVED
-- System path: 0 --(CREATE_EXPENSE)--> 1 --(WRITE_DB)--> 4 --(DATA_PERSISTED)--> 8 --(APP_TIMEOUT)--> 5
-- ACCEPT triggers after APP_TIMEOUT fires post-persistence but pre-balance.
process TP_A3 [
    CREATE_EXPENSE : ExpenseChannel,
    WRITE_DB       : ExpenseChannel,
    DATA_PERSISTED : ExpenseStatusChannel,
    BALANCE_SAVED  : ExpenseStatusChannel,
    UE1_OFFLINE    : none,
    APP_TIMEOUT    : TimeoutChannel,
    ACCEPT         : none,
    REFUSE         : none
] is
    CREATE_EXPENSE (?any GroupId, ?any ExpenseId, ?any Amount);
    WRITE_DB (?any GroupId, ?any ExpenseId, ?any Amount);
    DATA_PERSISTED (?any ExpenseId, ?any ExpenseStatus);
    APP_TIMEOUT (?any GroupId);
    loop ACCEPT end loop
end process


-- TP_A4 / TP_U2: Normal trace — no disruption
-- System path: 0 --(CREATE_EXPENSE)--> 1 --(WRITE_DB)--> 4 --(DATA_PERSISTED)--> 8 --(BALANCE_SAVED)--> 11
-- ACCEPT triggers after BALANCE_SAVED confirms end-to-end success.
process TP_A4 [
    CREATE_EXPENSE : ExpenseChannel,
    WRITE_DB       : ExpenseChannel,
    DATA_PERSISTED : ExpenseStatusChannel,
    BALANCE_SAVED  : ExpenseStatusChannel,
    UE1_OFFLINE    : none,
    APP_TIMEOUT    : TimeoutChannel,
    ACCEPT         : none,
    REFUSE         : none
] is
    CREATE_EXPENSE (?any GroupId, ?any ExpenseId, ?any Amount);
    WRITE_DB (?any GroupId, ?any ExpenseId, ?any Amount);
    DATA_PERSISTED (?any ExpenseId, ?any ExpenseStatus);
    BALANCE_SAVED (?any ExpenseId, ?any ExpenseStatus);
    loop ACCEPT end loop
end process

end module
